# La derivada de V(f) permite estimar la sensibilidad del
# front end
# Este código calcula la derivada numérica
# de V(f) respecto a la frecuencia f
# 1) Diferencia centrada de orden 2
# 2) Diferencia centrada de orden 4
# 3) Diferencia progresiva de orden 2
# Además se compara cuál método es mejor

import numpy as np

# numpy sirve para trabajar con arreglos y cálculos numéricos


# datos
# frecuencia en kHz
f = np.array([
10.0,12.5,15.0,17.5,20.0,
22.5,25.0,27.5,30.0,32.5,
35.0,37.5,40.0,42.5,45.0,
47.5,50.0,52.5,55.0,57.5,
60.0,62.5,65.0,67.5,70.0,
72.5,75.0,77.5,80.0,82.5,
85.0,87.5,90.0,92.5,95.0,
97.5,100.0,102.5,105.0,107.5
])

# voltaje V(f)
V = np.array([
0.842,0.911,0.986,1.062,1.143,
1.227,1.314,1.401,1.482,1.551,
1.216,1.048,0.866,0.689,0.521,
0.364,0.223,0.103,0.012,-0.041,
-0.057,-0.034,0.018,0.096,0.197,
0.318,0.452,0.579,0.700,0.809,
0.611,0.688,0.756,0.811,0.856,
0.894,0.926,0.954,0.980,1.004
])

# Aquí guardamos todos los valores experimentales
# f contiene las frecuencias
# V contiene el voltaje medido en cada frecuencia

h = 2.5

# h representa la separación entre frecuencias
# Como las frecuencias aumentan de 2.5 en 2.5:
# 12.5 - 10 = 2.5
# 15 - 12.5 = 2.5
# entonces:
# h = 2.5 kHz


# a)
#
# Fórmula: f'(x) ≈ [f(x+h) - f(x-h)] / (2h)
# Se usará para:
# f = 40 kHz
# f = 70 kHz

# derivada en 40khz


# Buscamos el indice donde está 40
i40 = np.where(f == 40)[0][0]

# np.where busca la posición del número 40
# [0][0] extrae el indice exacto


# Aplicamos la formula
dV40_o2 = (V[i40 + 1] - V[i40 - 1]) / (2 * h)

# V[i40 + 1] valor a la derecha
# V[i40 - 1] valor a la izquierda
# Fórmula:(V(42.5) - V(37.5)) / (2h)

# resultado
print("Derivada en 40 kHz (orden 2):", dV40_o2)

# derivada en 70khz

i70 = np.where(f == 70)[0][0]

dV70_o2 = (V[i70 + 1] - V[i70 - 1]) / (2 * h)

print("Derivada en 70 kHz (orden 2):", dV70_o2)

# b) 
#
# Fórmula:f'(x) ≈ [-f(x+2h) + 8f(x+h)-8f(x-h) + f(x-2h)] / 12h
# Este método es más preciso porque usa más puntos

# derivada en 40khz

dV40_o4 = (
    -V[i40 + 2]
    + 8 * V[i40 + 1]
    - 8 * V[i40 - 1]
    + V[i40 - 2]
) / (12 * h)

# V[i40 + 2] -> V(45)
# V[i40 + 1] -> V(42.5)
# V[i40 - 1] -> V(37.5)
# V[i40 - 2] -> V(35)
# Todo se divide entre 12h


print("Derivada en 40 kHz (orden 4):", dV40_o4)


# derivada en 70khz

dV70_o4 = (
    -V[i70 + 2]
    + 8 * V[i70 + 1]
    - 8 * V[i70 - 1]
    + V[i70 - 2]
) / (12 * h)

print("Derivada en 70 kHz (orden 4):", dV70_o4)

#c)
# Fórmula: f'(x) ≈ [-3f(x) + 4f(x+h) - f(x+2h)] / 2h
#
# Se usa en extremos porque no hay datos suficientes a la izquierda
#  f = 10 kHz

# derivada en 10khz

i10 = np.where(f == 10)[0][0]

dV10_prog = (
    -3 * V[i10]
    + 4 * V[i10 + 1]
    - V[i10 + 2]
) / (2 * h)

# V(10), V(12.5), V(15)
# Se reemplazan en la fórmula progresiva.


print("Derivada en 10 kHz (progresiva orden 2):", dV10_prog)



# interpretacion

print("\nINTERPRETACIÓN:")

# signo de derivadas
if dV40_o4 > 0:
    print("En 40 kHz el voltaje está aumentando.")
else:
    print("En 40 kHz el voltaje está disminuyendo.")

if dV70_o4 > 0:
    print("En 70 kHz el voltaje aún aumenta.")
else:
    print("En 70 kHz el voltaje empieza a disminuir.")

if dV10_prog > 0:
    print("En 10 kHz el crecimiento inicial es positivo.")


# comparamos

print("\nCOMPARACIÓN DE MÉTODOS:")

print("El método de orden 4 es más preciso")
print("porque usa más puntos alrededor del dato.")
print("La diferencia progresiva se usa en extremos.")

# la derivacion numerica permitio estimar la sensibilidad del voltaje 
#    respecto a la frecuencia usando datos experimentales discretos
# el metodo de diferencia centrada de orden 2 proporciono resultados 
#     aceptables y sencillos de calcular para aproximaciones rapidas
# el metodo de diferencia centrada de orden 4 fue mas preciso porque 
#     utiliza una mayor cantidad de puntos alrededor del dato y reduce el error numerico
# la diferencia progresiva se utilizo en el extremo inicial de los datos 
#     debido a que no existen puntos suficientes a la izquierda para aplicar 
