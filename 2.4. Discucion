# 2. EFECTO DE LA RESOLUCION INSTRUMENTAL

# Ningun instrumento mide perfectamente.
# Siempre existe:
# - ruido
# - error
# - incertidumbre
#
# Esto afecta:
# - interpolacion
# - derivadas
# - calculo de raices
#
# Simularemos el ruido experimental.

ruido = np.random.normal(0,0.03,len(V))

# genera ruido aleatorio.
#
# promedio = 0
# desviacion = 0.03
#
# esto simula pequeñas variaciones en las mediciones reales.

V_ruidoso = V + ruido

# nueva señal alterada por errores instrumentales.

# resultados

print("EFECTO DE LA RESOLUCION")
print(" ")

print("\nvoltajes originales:")
print(V)

print("\nvoltajes con ruido:")
print(V_ruidoso)

# interpretacion

print("\ninterpretacion tecnica:")

print("\ncuando los instrumentos")
print("tienen baja resolucion,")

print("las mediciones presentan")
print("errores y fluctuaciones.")

print("\nesto afecta directamente:")
print("- la interpolacion")
print("- las derivadas")
print("- la deteccion de raices")

print("\npor ejemplo, pequeñas")
print("variaciones pueden mover")
print("la posicion exacta")
print("de un cruce por cero.")

print("\ntambien pueden aparecer")
print("pendientes falsas en")
print("las derivadas numericas.")

# comparamos las graficas

plt.figure(figsize=(8,5))

plt.plot(f,V,
         marker='o',
         label='original')

plt.plot(f,V_ruidoso,
         marker='x',
         label='con ruido')

plt.title("efecto de la resolucion instrumental")

plt.xlabel("frecuencia (kHz)")

plt.ylabel("voltaje")

plt.legend()

plt.grid(True)

plt.show()

# spline cubico

# Los polinomios globales de alto grado pueden producir oscilaciones grandes.
# Esto ocurre especialmente cuando:
# - existen muchos datos
# - los puntos estan separados
#
# Los splines cubicos solucionan esto usando pequeños polinomios en cada intervalo.

spline = CubicSpline(f,V)

# crea una curva suave
# usando todos los puntos.

fx = np.linspace(10,107.5,2000)

# generamos  2000 puntos
# esto permite visualizar una curva continua y suave.

# EVALUAR SPLINE

fy = spline(fx)

# calcula el spline en todos los puntos generados.

# grafica

plt.figure(figsize=(8,5))

plt.plot(f,V,
         'o',
         label='datos experimentales')

plt.plot(fx,fy,
         label='spline cubico')

plt.title("interpolacion con spline cubico")

plt.xlabel("frecuencia (kHz)")

plt.ylabel("voltaje")

plt.legend()

plt.grid(True)

plt.show()

