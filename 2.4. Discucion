# 1. ANALISIS DE V(f) Y |Z(f)|
# En sistemas biomedicos es importante
# encontrar la frecuencia donde:
# - el sistema tiene mejor respuesta
# - existe mayor sensibilidad
# - hay menor perdida
#
# Analizaremos:
# - maximo voltaje
# - minimo valor de impedancia



# maximo voltaje

Vmax = np.max(V)

# busca el mayor voltaje del arreglo.

indice_Vmax = np.argmax(V)

# posicion donde esta el maximo.

f_Vmax = f[indice_Vmax]

# frecuencia asociada al maximo voltaje.

# minima impedancia

Zmin = np.min(Z)

# menor valor de impedancia.

indice_Zmin = np.argmin(Z)

# posicion donde esta el minimo.

f_Zmin = f[indice_Zmin]

# frecuencia asociada.



# resulñtados

print("ANALISIS DE BANDA DE OPERACION")

